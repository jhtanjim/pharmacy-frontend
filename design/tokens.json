        "50": { "$value": "#F9FAFB", "$type": "color" },
        "100": { "$value": "#F3F4F6", "$type": "color" },
        "200": { "$value": "#E5E7EB", "$type": "color" },
        "300": { "$value": "#D1D5DB", "$type": "color" },
        "400": { "$value": "#9CA3AF", "$type": "color" },
        "500": { "$value": "#6B7280", "$type": "color" },
        "600": { "$value": "#4B5563", "$type": "color" },
        "700": { "$value": "#374151", "$type": "color" },
        "800": { "$value": "#1F2937", "$type": "color" },
        "900": { "$value": "#111827", "$type": "color" },
        "950": { "$value": "#030712", "$type": "color" }
      },
      "green": {
        "50": { "$value": "#ECFDF5", "$type": "color" },
        "500": { "$value": "#22C55E", "$type": "color" },
        "600": { "$value": "#16A34A", "$type": "color" },
        "700": { "$value": "#15803D", "$type": "color" }
      },
      "red": {
        "50": { "$value": "#FEF2F2", "$type": "color" },
        "500": { "$value": "#EF4444", "$type": "color" },
        "600": { "$value": "#DC2626", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" }
      },
      "amber": {
        "50": { "$value": "#FFFBEB", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "600": { "$value": "#D97706", "$type": "color" }
      },
      "blue": {
        "50": { "$value": "#EFF6FF", "$type": "color" },
        "500": { "$value": "#3B82F6", "$type": "color" },
        "600": { "$value": "#2563EB", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "categorical": {
        "$description": "Identity colors for company badges only. Distinct from status colors (red/amber/green above) so a company badge is never mistaken for an expiry signal. Each passes WCAG AA (>=4.5:1) for white text at this shade.",
        "indigo": { "$value": "#4F46E5", "$type": "color" },
        "teal": { "$value": "#0F766E", "$type": "color" },
        "violet": { "$value": "#7C3AED", "$type": "color" },
        "cyan": { "$value": "#0E7490", "$type": "color" },
        "rose": { "$value": "#BE123C", "$type": "color" },
        "lime": { "$value": "#4D7C0F", "$type": "color" },
        "fuchsia": { "$value": "#A21CAF", "$type": "color" },
        "sky": { "$value": "#0369A1", "$type": "color" },
        "orange": { "$value": "#C2410C", "$type": "color" },
        "slate": { "$value": "#475569", "$type": "color" }
      }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm": { "$value": "0.125rem", "$type": "dimension" },
      "default": { "$value": "0.25rem", "$type": "dimension" },
      "md": { "$value": "0.375rem", "$type": "dimension" },
      "lg": { "$value": "0.75rem", "$type": "dimension" },
      "xl": { "$value": "1rem", "$type": "dimension" },
      "2xl": { "$value": "1.25rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "default": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.08), 0 1px 2px -1px rgb(0 0 0 / 0.06)", "$type": "shadow" },
      "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.06)", "$type": "shadow" },
      "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.05)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "300ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.gray.100}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.gray.900}", "$type": "color" },

      "surface": { "$value": "{primitive.color.white}", "$type": "color" },
      "surface-foreground": { "$value": "{primitive.color.gray.900}", "$type": "color" },

      "text-primary": { "$value": "{primitive.color.gray.900}", "$type": "color" },
      "text-secondary": { "$value": "{primitive.color.gray.500}", "$type": "color" },

      "primary": { "$value": "{primitive.color.green.600}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.green.700}", "$type": "color" },
      "primary-foreground": { "$value": "{primitive.color.white}", "$type": "color" },

      "secondary": { "$value": "{primitive.color.gray.100}", "$type": "color" },
      "secondary-foreground": { "$value": "{primitive.color.gray.900}", "$type": "color" },

      "muted": { "$value": "{primitive.color.gray.100}", "$type": "color" },
      "muted-foreground": { "$value": "{primitive.color.gray.500}", "$type": "color" },

      "border": { "$value": "{primitive.color.gray.200}", "$type": "color" },
      "ring": { "$value": "{primitive.color.green.600}", "$type": "color" },

      "danger": { "$value": "{primitive.color.red.600}", "$type": "color" },
      "danger-bg": { "$value": "{primitive.color.red.50}", "$type": "color" },
      "danger-foreground": { "$value": "{primitive.color.white}", "$type": "color" },

      "warning": { "$value": "{primitive.color.amber.500}", "$type": "color" },
      "warning-bg": { "$value": "{primitive.color.amber.50}", "$type": "color" },
      "warning-foreground": { "$value": "{primitive.color.gray.900}", "$type": "color" },

      "success": { "$value": "{primitive.color.green.600}", "$type": "color" },
      "success-bg": { "$value": "{primitive.color.green.50}", "$type": "color" },
      "success-foreground": { "$value": "{primitive.color.white}", "$type": "color" },

      "info": { "$value": "{primitive.color.blue.600}", "$type": "color" },
      "info-bg": { "$value": "{primitive.color.blue.50}", "$type": "color" }
    },
    "spacing": {
      "component": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "section": { "$value": "{primitive.spacing.8}", "$type": "dimension" }
    },
    "typography": {
      "headline-lg": { "$value": "{primitive.fontSize.4xl}", "$type": "dimension" },
      "headline": { "$value": "{primitive.fontSize.2xl}", "$type": "dimension" },
      "stat-number": { "$value": "{primitive.fontSize.3xl}", "$type": "dimension" },
      "body": { "$value": "{primitive.fontSize.base}", "$type": "dimension" },
      "body-sm": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "label": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "caption": { "$value": "{primitive.fontSize.xs}", "$type": "dimension" }
    }
  },
  "component": {
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "shadow": { "$value": "{primitive.shadow.sm}", "$type": "shadow" },
      "padding": { "$value": "{primitive.spacing.5}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.xl}", "$type": "dimension" }
    },
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" }
    },
    "badge": {
      "danger-bg": { "$value": "{semantic.color.danger-bg}", "$type": "color" },
      "danger-fg": { "$value": "{semantic.color.danger}", "$type": "color" },
      "warning-bg": { "$value": "{semantic.color.warning-bg}", "$type": "color" },
      "warning-fg": { "$value": "{primitive.color.amber.600}", "$type": "color" },
      "success-bg": { "$value": "{semantic.color.success-bg}", "$type": "color" },
      "success-fg": { "$value": "{semantic.color.success}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.1}", "$type": "dimension" }
    }
  }
